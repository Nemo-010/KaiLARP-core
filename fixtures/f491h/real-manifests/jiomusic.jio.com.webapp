{
  "name": "JioMusic",
  "subtitle": "Music for you. Anytime. Anywhere.",
  "description": "Millions of HD songs in over 20 languages. Unmatched clarity. Unbeatable experience.",
  "theme": "#51b7c1",
  "display": "JioSaavn",
  "version": "3.9.0.1",
  "launch_path": "/index.html",
  "type": "privileged",
  "origin": "app://jiomusic.jio.com",
  "icons": {
    "56": "/resources/icons/JS-56.png",
    "84": "/resources/icons/JS-84.png",
    "112": "/resources/icons/JS-112.png"
  },
  "developer": {
    "name": "JioSaavn",
    "url": "http://www.jiosaavn.com"
  },
  "fullscreen": true,
  "type": "privileged",
  "datastores-access": {
    "jio_service_store": {
      "readonly": false,
      "description": "Jio Service store"
    },
    "jio_adssdk_store": {
      "access": "readonly",
      "description":"Jio ad sdk store"
    }
  },
  "messages":[
    {"serviceworker-notification":"/index.html"}
  ],
  "activities": {
    "JioMusic": {
    "href": "/index.html",
    "disposition": "window",
    "returnValue": true,
    "filters": {
      "type": "text"
    }
  }
},
  "permissions": {
    "push": {
      "description": "To receive notifications"
    },
    "serviceworker": {},
    "audio-channel-normal" : {
      "description" : "Needed to play this app's audio content on the normal channel"
    },
    "audio-channel-content" : {
      "description" : "Needed to play this app's audio content on the content channel"
    },
    "desktop-notification" : {
      "description" : "Needed to fire system notifications"
    },
    "systemXHR": {
      "description": "This permission is require to call web api"
    },
    "device-storage:sdcard": {
      "name": "device-storage:sdcard",
      "access": "readwrite"
    },
    "device-storage:music":{ 
      "access": "readwrite"
    },
    "audio-capture": {},
    "browser": {},
    "udp-socket": {
      "description": "Used for ssdp implementation."
    },
    "tcp-socket": {
      "description": "Create TCP sockets and communicate over them."
    },
    "volumemanager": {},
    "feature-detection": {             
      "description": "Required by AdsSDK to differentiate between candy and qwerty phones"         
    },
    "spatialnavigation-app-manage":{
      "description": "Required by AdsSDK to enable spatial navigation if required"
    },
    "geolocation": {             
      "description" : "Required by AdsSDK to fetch the location"
    },
    "donglemanager" : {
      "description": "Used for the local IP address."
    }   
  },
  "default_locale": "en-US",
  "locales": {
    "en-US": {
      "name": "JioSaavn",
      "description": "Millions of HD songs in over 20 languages. Unmatched clarity. Unbeatable experience.",
      "subtitle": "Music for you. Anytime. Anywhere."
    },
